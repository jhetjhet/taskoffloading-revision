# Industrial IoT task-offloading simulation
# Copy to .env to override local Docker Compose defaults.

FRONTEND_PORT=5173
SIMULATION_API_PORT=8000
SIMULATION_FORECAST_TICK_SEC=0.1
SIMULATION_EXECUTION_TICK_SEC=0.01
SIMULATION_TIME_SCALE=0.05
SIMULATION_EVENT_DELAY_SEC=0.02
SIMULATION_RUN_TIMEOUT_SEC=3600

POSTGRES_DB=taskoffloading
POSTGRES_USER=taskoffloading
POSTGRES_PASSWORD=taskoffloading
